# Copia a .env.local (Vite) y rellena con datos reales. No subas secretos al repositorio.

# URL pública del sitio (sin barra final). Obligatoria en build de producción para sitemap.xml,
# robots.txt (Sitemap absoluto), canonical, Open Graph y hreflang.
# En GitHub Actions: variable del repositorio VITE_SITE_ORIGIN (Settings → Secrets and variables → Actions → Variables).
VITE_SITE_ORIGIN=

# API backend (opcional si el proxy por defecto basta)
VITE_API_URL=

# WhatsApp en formato E.164 sin +: ej. 519998887766
VITE_WHATSAPP_E164=

# Teléfono celular para llamadas directas en formato E.164 sin +: ej. 519998887766
VITE_PHONE_CALL=

# Google Maps / ficha de negocio (URLs completas)
VITE_MAPS_URL=
VITE_GOOGLE_BUSINESS_URL=

# Redes (URLs completas)
VITE_SOCIAL_INSTAGRAM_URL=
VITE_SOCIAL_FACEBOOK_URL=
VITE_SOCIAL_TIKTOK_URL=

# Dirección postal para JSON-LD (solo si quieres publicarla). Localidad por defecto Arequipa en schema si no envías calle.
VITE_BUSINESS_ADDRESS_STREET=
VITE_BUSINESS_ADDRESS_LOCALITY=Arequipa
VITE_BUSINESS_ADDRESS_REGION=
VITE_BUSINESS_ADDRESS_POSTAL=
VITE_BUSINESS_ADDRESS_COUNTRY=PE

# Horarios en JSON-LD: array JSON de objetos OpeningHoursSpecification (schema.org)
VITE_BUSINESS_OPENING_HOURS_JSON=

# Google Analytics 4 (Measurement ID G-XXXXXXXXXX)
VITE_GA_MEASUREMENT_ID=

# Meta tag de verificación de Google Search Console
VITE_GOOGLE_SITE_VERIFICATION=

# Correo de contacto para temas de privacidad (se muestra en /politica-de-privacidad si está definido)
VITE_PRIVACY_CONTACT_EMAIL=
