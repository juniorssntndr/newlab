# URL de la base de datos (PostgreSQL local en VPS/Coolify o externa en Supabase)
# Para Coolify, si el backend está en el mismo stack Docker, podés usar el host interno "postgres:5432"
# Ejemplo local/VPS: postgresql://username:password@postgres:5432/database_name
# Ejemplo si conectás desde afuera (Render): postgresql://username:password@vps-ip:puerto_publico/database_name
DATABASE_URL=postgresql://username:password@postgres:5432/database_name

JWT_SECRET=replace-with-a-long-random-secret
PORT=3001
FRONTEND_ORIGIN=https://tu-frontend.vercel.app

# Almacenamiento de Imágenes
# Dejá SUPABASE_URL y SUPABASE_SERVICE_ROLE_KEY vacíos para usar almacenamiento local persistente en el VPS (carpeta /uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=product-images

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# Google Calendar / Meet
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
GOOGLE_CALENDAR_TOKEN_ENCRYPTION_KEY=replace-with-32-plus-random-chars
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=America/Lima

# External API — token DNI/RUC de APISPERU (plan consultas). NUNCA reutilizar el token de facturación.
EXTERNAL_API_TOKEN=tu_token_secreto_aqui_apis_net_pe

# Facturacion electronica APISPERU
# El token permanente de empresa se guarda en nl_empresas.token_apisperu (no en el navegador).
# Ideal: moverlo a secretos de Coolify y rotarlo antes de producción.
USE_NEW_BILLING_ACL=true
APISPERU_BASE_URL=https://facturacion.apisperu.com/api/v1
APISPERU_TIMEOUT_MS=20000
# true simula respuestas; false envia realmente al entorno configurado en nl_empresas
APISPERU_MOCK=true
# Caché de consultas DNI/RUC (segundos). Default 3600.
# IDENTITY_CACHE_TTL_SECONDS=3600
