# Optional: same-domain /api and /uploads proxy (Coolify Custom Nginx Configuration).
# Replace BACKEND_INTERNAL_HOST with the backend container hostname on the Coolify Docker network
# (visible in the backend service → General → internal URL / container name).
#
# Prefer VITE_API_URL=https://bak.affinixlab.com/api in the frontend build when the backend
# already has a public domain (current production setup).

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://BACKEND_INTERNAL_HOST:3000/api/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /uploads/ {
        proxy_pass http://BACKEND_INTERNAL_HOST:3000/uploads/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
